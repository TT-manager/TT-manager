# Pubbliche (non segrete): si trovano in Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://dgpjykiacbvcvxxrhzur.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SEGRETA, solo lato server. Mai con prefisso NEXT_PUBLIC, mai nel repository.
# Supabase -> Settings -> API Keys -> Secret keys (sb_secret_...). Su Vercel: Environment Variables.
SUPABASE_SECRET_KEY=

# Dati del gestore, mostrati nel footer e nelle pagine Privacy / Termini (pubblici).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_ADDRESS=

# SEGRETA. Brevo -> SMTP e API -> Chiavi API (permesso: solo «Transactional email»). Notifiche e riepilogo del lunedì.
BREVO_API_KEY=
# Facoltativa: mittente delle email (deve essere confermato in Brevo). Di base: NEXT_PUBLIC_SUPPORT_EMAIL.
EMAIL_FROM=

# SEGRETA. Parola d'ordine con cui Vercel chiama i lavori programmati (backup, controllo giornaliero, riepilogo).
CRON_SECRET=
